<!-- BARRA DE ACESSIBILIDADE (padrão em todo o sistema) -->
<div id="barra-acessibilidade" class="barra-acessibilidade" role="toolbar">
    <div class="barra-acessibilidade__inner">
        <span class="barra-acessibilidade__label" aria-hidden="true">Acessibilidade:</span>

        <button id="btn-contraste" class="btn-acess" aria-pressed="false" aria-label="Alternar modo alto contraste">
            <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10" />
                <path d="M12 2v20" />
            </svg>
            <span>Contraste</span>
        </button>

        <button id="btn-aumentar-fonte" class="btn-acess" aria-label="Aumentar tamanho da fonte">
            <span>A+</span>
        </button>

        <button id="btn-diminuir-fonte" class="btn-acess" aria-label="Diminuir tamanho da fonte">
            <span>A-</span>
        </button>

        <button id="btn-layout" class="btn-acess" aria-pressed="false" aria-label="Alternar layout simplificado">
            <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <line x1="3" y1="9" x2="21" y2="9" />
                <line x1="3" y1="15" x2="21" y2="15" />
            </svg>
            <span>Simplificado</span>
        </button>

        <button id="btn-leitura" class="btn-acess" aria-pressed="false" aria-label="Alternar modo leitura">
            <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none"
                stroke="currentColor" stroke-width="2">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
            </svg>
            <span>Leitura</span>
        </button>
    </div>
</div>

