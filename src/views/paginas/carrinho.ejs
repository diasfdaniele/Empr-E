<main id="conteudo-principal" tabindex="-1">
  <section class="carrinho-destaque">
    <div class="container">
      <div class="carrinho-destaque__conteudo">
        <span class="secao-selo">Demonstração</span>
        <h1 class="carrinho-destaque__titulo">Seu carrinho</h1>
        <p class="carrinho-destaque__texto">
          Exemplo independente do catálogo. Alterações se perdem ao navegar ou recarregar.
        </p>
      </div>
    </div>
  </section>
  <section class="carrinho-secao" aria-labelledby="lista-carrinho-titulo">
    <div class="container">
      <div class="row g-4 align-items-start">
        <div class="col-lg-8">
          <div class="carrinho-painel">
            <div class="carrinho-painel__cabecalho">
              <h2 id="lista-carrinho-titulo" class="carrinho-painel__titulo">Itens de exemplo</h2>
              <a href="/catalogo" class="btn botao--discreto">Continuar explorando</a>
            </div>
            <div id="lista-carrinho" class="carrinho-lista">
              <% for (const { produto, quantidade: quantidadeItem, variacao } of itens) { %>
              <article
                class="carrinho-item"
                data-linha-carrinho=""
                data-preco="<%= produto.preco %>"
                data-compra="<%= produto.modalidade === "compra" %>"
              >
                <div class="carrinho-item__midia">
                  <img src="<%= produto.imagens[0] %>" alt="<%= produto.nome %>" width="90" height="90" />
                </div>
                <div>
                  <div class="carrinho-item__cabecalho">
                    <h3><a href="/produto/<%= produto.id %>"><%= produto.nome %></a></h3>
                    <p class="carrinho-item__empresa"><%= produto.empresa.nome %></p>
                  </div>
                  <span class="carrinho-item__categoria"><%= produto.categoria.nome %></span>
                  <p class="carrinho-item__descricao"><%= produto.descricao %></p>
                  <p class="carrinho-item__meta"><%= variacao %> · <%= produto.nomeModalidade %></p>
                  <div class="carrinho-item__controles">
                    <div class="carrinho-item__quantidade" aria-label="Quantidade de <%= produto.nome %>">
                      <button
                        type="button"
                        aria-label="Diminuir quantidade de <%= produto.nome %>"
                        title="Diminuir quantidade"
                        data-quantidade="diminuir"
                      >
                        <img src="/icones/minus.svg" width="18" height="18" alt="" /></button
                      ><span aria-live="polite" data-quantidade-item=""><%= quantidadeItem %></span
                      ><button
                        type="button"
                        aria-label="Aumentar quantidade de <%= produto.nome %>"
                        title="Aumentar quantidade"
                        data-quantidade="aumentar"
                      >
                        <img src="/icones/plus.svg" width="18" height="18" alt="" />
                      </button>
                    </div>
                    <button
                      type="button"
                      class="carrinho-item__remover"
                      aria-label="Remover <%= produto.nome %>"
                      title="Remover item"
                      data-remover=""
                    >
                      <img src="/icones/trash-2.svg" width="20" height="20" alt="" />
                    </button>
                  </div>
                </div>
                <div class="carrinho-item__lateral">
                  <span class="carrinho-item__preco"><%= formatarMoeda(produto.preco) %>/<%= produto.unidade %></span
                  ><span class="carrinho-item__meta"><%= produto.modalidade === "compra" ? "Compra ilustrativa" : "Orçamento indisponível" %></span>
                </div>
              </article>
              <% } %>
            </div>
            <section class="orcamento-demo" aria-labelledby="orcamento-titulo">
              <h2 id="orcamento-titulo" class="carrinho-painel__titulo">
                Projeto personalizado e orçamento
              </h2>
              <p>Solicitações estarão disponíveis em uma próxima etapa.</p>
              <button type="button" class="btn botao--contorno" disabled="">
                Solicitar orçamento indisponível
              </button>
            </section>
          </div>
        </div>
        <div class="col-lg-4">
          <aside class="carrinho-resumo" aria-label="Resumo demonstrativo">
            <span class="carrinho-resumo__rotulo">Exemplo</span>
            <h2 class="carrinho-resumo__titulo">Seu resumo</h2>
            <p class="carrinho-resumo__texto">
              O total inclui somente itens de compra imediata. Projetos não são cobrados.
            </p>
            <dl class="carrinho-metricas">
              <div class="carrinho-metrica">
                <dt>Quantidade</dt>
                <dd id="resumo-quantidade"><%= quantidade %></dd>
              </div>
              <div class="carrinho-metrica">
                <dt>Total ilustrativo</dt>
                <dd id="resumo-valor"><%= formatarMoeda(total) %></dd>
              </div>
            </dl>
            <div class="carrinho-resumo__acoes">
              <a href="/pagamento" class="btn botao--principal w-100">Ver pagamento ilustrativo</a
              ><button type="button" id="botao-limpar-carrinho" class="btn botao--contorno w-100">
                <img src="/icones/trash-2.svg" width="18" height="18" alt="" />Limpar exemplo
              </button>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </section>
</main>
