<main id="conteudo-principal" tabindex="-1">
  <section class="catalogo-destaque">
    <div class="container">
      <div class="catalogo-destaque__conteudo">
        <h1 class="catalogo-destaque__titulo">Empresas Parceiras</h1>
        <p class="catalogo-destaque__texto">
          Conheça as organizações que fazem a diferença no nosso marketplace.
        </p>
      </div>
    </div>
  </section>

  <section class="catalogo-produtos">
    <div class="container">
      <form class="empresas-filtros filtros" id="filtros-empresas" role="search" aria-label="Filtrar empresas">
        <div class="filtro-grupo">
          <label for="empresa-busca" class="filtro-rotulo">Nome da empresa</label>
          <input
            id="empresa-busca"
            class="campo-entrada"
            type="search"
            placeholder="Buscar por nome"
            autocomplete="off"
          />
        </div>
        <div class="filtro-grupo">
          <label for="empresa-setor" class="filtro-rotulo">Setor</label>
          <select id="empresa-setor" class="campo-entrada campo-seletor">
            <option value="">Todos os setores</option>
            <% for (const setor of setores || []) { %>
              <option value="<%= setor %>"><%= setor %></option>
            <% } %>
          </select>
        </div>
        <div class="filtro-grupo">
          <label for="empresa-ordenacao" class="filtro-rotulo">Ordenar por</label>
          <select id="empresa-ordenacao" class="campo-entrada campo-seletor">
            <option value="az">Nome (A–Z)</option>
            <option value="za">Nome (Z–A)</option>
          </select>
        </div>
        <button type="reset" class="btn botao--discreto">Limpar filtros</button>
      </form>

      <div class="catalogo__cabecalho mt-4">
        <h2 class="catalogo__titulo">Empresas encontradas</h2>
        <span class="catalogo__resultado" id="empresas-resultado" role="status" aria-live="polite">
          <%= empresas ? empresas.length : 0 %> <%= empresas && empresas.length === 1 ? 'empresa encontrada' : 'empresas encontradas' %>
        </span>
      </div>

      <div class="catalogo__grade" id="empresas-grade">
        <% if (empresas && empresas.length > 0) { %>
          <% for (const emp of empresas) { %>
            <article
              class="produto-cartao"
              data-empresa-card
              data-nome="<%= emp.nomeFantasia %>"
              data-setor="<%= emp.categoriaEmpresa %>"
            >
              <div class="produto-cartao__midia empresas-cadastradas__midia">
                <% if (emp.logoUrl) { %>
                  <img
                    class="empresas-cadastradas__logo"
                    src="<%= emp.logoUrl %>"
                    alt="Logo da empresa <%= emp.nomeFantasia %>"
                    width="320"
                    height="220"
                    loading="lazy"
                    decoding="async"
                  />
                <% } else { %>
                  <span class="empresas-cadastradas__sem-logo" aria-hidden="true">
                    <%= (emp.nomeFantasia || 'E').slice(0, 1).toLocaleUpperCase('pt-BR') %>
                  </span>
                <% } %>
              </div>
              
              <div class="produto-cartao__conteudo">
                <span class="produto-cartao__categoria"><%= emp.categoriaEmpresa %></span>
                <h3 class="produto-cartao__titulo">
                  <%= emp.nomeFantasia %>
                </h3>
                
                <p class="produto-cartao__descricao">
                  Empresa vendedora cadastrada na Empr-E.
                </p>
                
                <div class="produto-cartao__rodape">
                  <div class="produto-cartao__acoes w-100">
                    <a href="/catalogo?empresa=<%= encodeURIComponent(emp.nomeFantasia) %>" class="btn botao--contorno w-100">
                      Ver produtos da empresa &rarr;
                    </a>
                  </div>
                </div>
              </div>
            </article>
          <% } %>
        <% } %>
      </div>
      <p id="empresas-sem-resultados" class="empresas-sem-resultados" <%= empresas && empresas.length ? 'hidden' : '' %>>
        Nenhuma empresa encontrada com esses filtros.
      </p>
    </div>
  </section>
</main>