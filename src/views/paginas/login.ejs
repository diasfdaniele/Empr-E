<main id="conteudo-principal" class="entrada-principal" tabindex="-1">
  <div class="entrada-estrutura">
    <aside class="entrada-lateral" aria-label="Informações sobre a Empr-E">
      <div class="entrada-lateral__interno">
        <a
          href="/"
          class="entrada-lateral__voltar"
          aria-label="Voltar para a página inicial da Empr-E"
        >
          <svg
            aria-hidden="true"
            focusable="false"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
          >
            <path d="M19 12H5"></path>
            <path d="m12 5-7 7 7 7"></path>
          </svg>
          Página inicial
        </a>

        <div class="entrada-lateral__conteudo">
          <h1 class="entrada-lateral__titulo">
            Acessibilidade<br /><span class="entrada-lateral__titulo-destaque">para pessoas</span
            ><br />e empresas.
          </h1>

          <p class="entrada-lateral__subtitulo">
            Uma plataforma para encontrar soluções de acessibilidade para diferentes necessidades.
          </p>

          <ul
            class="entrada-lateral__diferenciais ps-0 mb-0"
            role="list"
            aria-label="Diferenciais da plataforma"
          >
            <li class="entrada-lateral__diferencial">
              <div class="entrada-lateral__diferencial-icone" aria-hidden="true">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="m9 12 2 2 4-4"></path>
                </svg>
              </div>
              <span>Soluções demonstrativas de acessibilidade</span>
            </li>
            <li class="entrada-lateral__diferencial">
              <div class="entrada-lateral__diferencial-icone" aria-hidden="true">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M2 12h20"></path>
                  <path
                    d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
                  ></path>
                </svg>
              </div>
              <span>Soluções demonstrativas de acessibilidade</span>
            </li>
            <li class="entrada-lateral__diferencial">
              <div class="entrada-lateral__diferencial-icone" aria-hidden="true">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <span>Diferentes soluções para diferentes necessidades</span>
            </li>
            <li class="entrada-lateral__diferencial">
              <div class="entrada-lateral__diferencial-icone" aria-hidden="true">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <rect x="2" y="3" width="20" height="14" rx="2"></rect>
                  <path d="M8 21h8"></path>
                  <path d="M12 17v4"></path>
                </svg>
              </div>
              <span>Suporte especializado em acessibilidade</span>
            </li>
          </ul>
        </div>

        <div class="entrada-lateral__rodape">
          <p class="entrada-lateral__assinatura">
            Construído com acessibilidade em primeiro lugar.
          </p>
        </div>
      </div>
    </aside>

    <section class="entrada-painel" aria-labelledby="entrada-titulo-formulario">
      <div class="entrada-painel__interno">
        <div class="entrada-formulario-cabecalho">
          <h2 id="entrada-titulo-formulario" class="entrada-formulario-titulo">
            Bem-vindo de volta
          </h2>
          <p class="entrada-formulario-subtitulo">
            Utilize seus dados para entrar no Empr-E
          </p>
        </div>

        <form
          id="formulario-entrada"
          class="entrada-formulario"
          action="/login"
          method="POST"
          aria-label="Formulário de acesso à conta"
          autocomplete="on"
        >
        <% if (erro) { %>
          <p class="campo-erro" role="alert"><%= erro %></p>
        <% } %>
          <div class="campo-grupo" id="grupo-email">
            <label for="campo-email" class="campo-rotulo">
              E-mail
              <span class="campo-obrigatorio" aria-hidden="true">*</span>
            </label>
            <div class="campo-envoltorio">
              <span class="campo-icone campo-icone--esquerda" aria-hidden="true">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path
                    d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"
                  ></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
              </span>
              <input
                type="email"
                id="campo-email"
                class="campo-entrada"
                placeholder="empresa@exemplo.com.br"
                autocapitalize="none"
                spellcheck="false"
                aria-required="true"
                aria-describedby="email-dica email-erro"
                aria-invalid="false"
                name="email"
                required
                autocomplete="email"
              />
            </div>
            <span id="email-dica" class="somente-leitor"
              >Use o e-mail cadastrado pela sua empresa.</span
            >
            <span
              id="email-erro"
              class="campo-erro"
              role="alert"
              aria-live="polite"
              hidden=""
            ></span>
          </div>

          <div class="campo-grupo" id="grupo-senha">
            <label for="campo-senha" class="campo-rotulo">
              Senha
              <span class="campo-obrigatorio" aria-hidden="true">*</span>
            </label>
            <div class="campo-envoltorio">
              <span class="campo-icone campo-icone--esquerda" aria-hidden="true">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
              </span>
              <input
                type="password"
                id="campo-senha"
                class="campo-entrada campo-entrada--com-acao"
                placeholder="Sua senha de acesso"
                aria-required="true"
                aria-describedby="senha-erro"
                aria-invalid="false"
                minlength="8"
                name="senha"
                required
                autocomplete="current-password"
              />
              <button
                type="button"
                id="botao-mostrar-senha"
                class="campo-icone campo-icone--direita campo-icone--botao"
                aria-label="Mostrar senha"
                aria-pressed="false"
                title="Mostrar ou ocultar senha"
              >
                <svg
                  id="icone-senha-oculta"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path
                    d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"
                  ></path>
                  <line x1="1" y1="1" x2="23" y2="23"></line>
                </svg>
              </button>
            </div>
            <span
              id="senha-erro"
              class="campo-erro"
              role="alert"
              aria-live="polite"
              hidden=""
            ></span>
          </div>

          <div class="entrada-formulario-opcoes">
            <label class="caixa-selecao-rotulo" for="lembrar-me">
              <input
                type="checkbox"
                id="lembrar-me"
                class="caixa-selecao-entrada"
                aria-describedby="lembrar-dica"
                disabled=""
                autocomplete="off"
              />
              <span class="caixa-selecao-personalizado" aria-hidden="true"></span>
              <span class="caixa-selecao-texto">Lembrar minha conta</span>
            </label>
            <span id="lembrar-dica" class="somente-leitor"
              >Recurso indisponível: não há sessão nesta versão.</span
            >

            <span>Recuperação de senha indisponível.</span>
          </div>

          <button
            type="submit"
            id="botao-entrar"
            class="btn botao--principal botao--lg botao-entrada-enviar"
            aria-describedby="botao-entrar-estado"
          >
            <span class="botao-entrada-enviar__texto">Entrar</span>
            <span class="botao-entrada-enviar__carregando" hidden="" aria-hidden="true">
              <svg
                class="carregando-indicador"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
              </svg>
              Entrando...
            </span>
          </button>
          <span id="botao-entrar-estado" class="somente-leitor" aria-live="polite"></span>

          <div class="entrada-divisoria" role="separator">
            <span class="entrada-divisoria__linha" aria-hidden="true"></span>
            <span class="entrada-divisoria__texto" aria-hidden="true">ou</span>
            <span class="entrada-divisoria__linha" aria-hidden="true"></span>
          </div>

          <p class="entrada-suporte-texto">
            Ainda não tem conta?
            <a href="/cadastro" class="entrada-link">Crie gratuitamente</a>
            · Dúvidas?
            <a href="/#contato" class="entrada-link">Contato</a>
          </p>
        </form>

        <footer class="entrada-painel-rodape" role="contentinfo" aria-label="Informações legais">
          <a href="/" class="entrada-painel-rodape__logo" aria-label="Empr-E - Página inicial">
            <svg
              class="marca-logo"
              width="110"
              height="36"
              viewBox="0 0 220 72"
              fill="none"
              aria-hidden="true"
            >
              <polygon
                class="marca-logo__hex"
                points="28,4 52,4 64,24 52,44 28,44 16,24"
                fill="#F97316"
              ></polygon>
              <rect x="23" y="11" width="4" height="22" rx="1.5" fill="white"></rect>
              <rect x="23" y="11" width="16" height="4" rx="1.5" fill="white"></rect>
              <rect x="23" y="21" width="12" height="3.5" rx="1.5" fill="white"></rect>
              <rect x="23" y="29" width="16" height="4" rx="1.5" fill="white"></rect>
              <circle
                class="marca-logo__ponto-externo"
                cx="52"
                cy="8"
                r="4"
                fill="#1E293B"
              ></circle>
              <circle
                class="marca-logo__ponto-interno"
                cx="52"
                cy="8"
                r="2"
                fill="#F97316"
              ></circle>
              <text
                class="marca-logo__nome"
                x="74"
                y="32"
                font-family="'Plus Jakarta Sans',sans-serif"
                font-size="26"
                font-weight="800"
                fill="#1E293B"
                letter-spacing="-0.5"
              >
                Empr
                <tspan class="marca-logo__nome-destaque" fill="#F97316">-E</tspan>
              </text>
              <text
                class="marca-logo__assinatura"
                x="74"
                y="48"
                font-family="'Plus Jakarta Sans',sans-serif"
                font-size="9"
                font-weight="500"
                fill="#64748B"
                letter-spacing="0.3"
              >
                Marketplace de Acessibilidade
              </text>
            </svg>
          </a>
          <p>
            Ao entrar, você concorda com nossos
            <a href="/institucional#termos-uso" class="entrada-link">Termos de Uso</a>
            e
            <a href="/institucional#politica-privacidade" class="entrada-link"
              >Política de Privacidade</a
            >.
          </p>
          <p class="entrada-painel-rodape__acess">
            <svg
              aria-hidden="true"
              focusable="false"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M2 12h20"></path>
              <path
                d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
              ></path>
            </svg>
            Versão demonstrativa
          </p>
        </footer>
      </div>
    </section>
  </div>

  <div
    id="aviso-conteiner"
    class="aviso-conteiner"
    aria-live="polite"
    aria-atomic="true"
    role="status"
    hidden=""
  ></div>
</main>
