              <circle cx="348" cy="284" r="8"></circle>
            </g>
          </g>
        </svg>
      </div>
    </div>

    <div class="destaque__fundo-decoracao" aria-hidden="true">
      <div class="destaque__fundo-forma destaque__fundo-forma--1"></div>
      <div class="destaque__fundo-forma destaque__fundo-forma--2"></div>
      <div class="destaque__fundo-grade"></div>
    </div>
  </section>

  <section class="categorias" aria-labelledby="categorias-titulo">
    <div class="container">
      <div class="secao-cabecalho">
        <h2 id="categorias-titulo" class="secao-titulo">Categorias de produtos</h2>
        <p class="secao-subtitulo">Diferentes soluções para diferentes necessidades.</p>
      </div>

      <div class="categorias__grade" role="list">
        <article class="categoria-cartao" role="listitem">
          <a href="/catalogo?categoria=1" class="categoria-cartao__link">
            <div class="categoria-cartao__icone" aria-hidden="true">
              <svg
                width="34"
                height="34"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="5" r="3"></circle>
                <path d="M10 8v5l3 1"></path>
                <path d="M9 11H6"></path>
                <path d="M13 13l5 5"></path>
                <circle cx="12" cy="19" r="4"></circle>
              </svg>
            </div>
            <h3 class="categoria-cartao__nome">Mobilidade e Locomoção</h3>
          </a>
        </article>

        <article class="categoria-cartao" role="listitem">
          <a href="/catalogo?categoria=2" class="categoria-cartao__link">
            <div class="categoria-cartao__icone" aria-hidden="true">
              <svg
                width="34"
                height="34"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M2 12s4-6 10-6 10 6 10 6-4 6-10 6-10-6-10-6z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </div>
            <h3 class="categoria-cartao__nome">Deficiência Visual</h3>
          </a>
        </article>

        <article class="categoria-cartao" role="listitem">
          <a href="/catalogo?categoria=3" class="categoria-cartao__link">
            <div class="categoria-cartao__icone" aria-hidden="true">
              <svg
                width="34"
                height="34"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="4" width="18" height="12" rx="2"></rect>
                <path d="M8 20h8"></path>
                <path d="M12 16v4"></path>
              </svg>
            </div>
            <h3 class="categoria-cartao__nome">Acessibilidade Digital</h3>
          </a>
        </article>
      </div>

      <div class="categorias__rodape">
        <a href="/catalogo" class="btn botao--discreto" aria-label="Catálogo"
          >Explorar o catálogo →</a
        >
      </div>
    </div>
  </section>

  <section id="sobre" class="sobre" aria-labelledby="sobre-titulo">
    <div class="container">
      <div class="sobre__interno">
        <div class="sobre__conteudo">
          <div class="secao-selo">Nossa missão</div>
          <h2 id="sobre-titulo" class="secao-titulo">
            Somos uma plataforma construída para quem <em>transforma vidas.</em>
          </h2>
          <p class="sobre__texto">
            A Empr-E nasceu com um propósito claro: aproximar pessoas e empresas de soluções de
            acessibilidade. Nosso marketplace B2B e B2C entende que inclusão não é tendência, é uma
            responsabilidade.
          </p>
          <p class="sobre__texto">
            Conectamos fabricantes, distribuidores e prestadores de serviços acessíveis a pessoas,
            empresas, instituições públicas e organizações que buscam tornar seus espaços e
            experiências inclusivos.
          </p>
          <a href="#como-funciona" class="btn botao--principal">Como funciona →</a>
        </div>

        <div class="sobre__pilares" role="list">
          <div class="pilar" role="listitem">
            <div class="pilar__icone" aria-hidden="true">
              <svg
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </div>
            <h3 class="pilar__titulo">Pessoas e empresas</h3>
            <p class="pilar__texto">
              Soluções acessíveis para necessidades individuais e de organizações, reunidas em um só
              lugar.
            </p>
          </div>

          <div class="pilar" role="listitem">
            <div class="pilar__icone" aria-hidden="true">
              <svg
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <h3 class="pilar__titulo">Curadoria especializada</h3>
            <p class="pilar__texto">
              Encontre empresas dedicadas à acessibilidade e conheça as soluções que combinam com
              sua rotina, seu espaço e suas necessidades.
            </p>
          </div>

          <div class="pilar" role="listitem">
            <div class="pilar__icone" aria-hidden="true">
              <svg
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <path d="m9 12 2 2 4-4"></path>
              </svg>
            </div>
            <h3 class="pilar__titulo">Conformidade com normas</h3>
            <p class="pilar__texto">
              Soluções alinhadas à ABNT NBR 9050, Lei Brasileira de Inclusão e padrões
              internacionais.
            </p>
          </div>

          <div class="pilar" role="listitem">
            <div class="pilar__icone" aria-hidden="true">
              <svg
                width="28"
                height="28"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
              </svg>
            </div>
            <h3 class="pilar__titulo">Impacto social mensurável</h3>
            <p class="pilar__texto">
              Cada negociação realizada representa um passo real em direção a um mundo mais
              inclusivo.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="empresas" class="empresas-parceiras" aria-labelledby="empresas-titulo">
    <div class="container">
      <div class="secao-cabecalho">
        <div class="secao-selo">Ecossistema Empr-E</div>
        <h2 id="empresas-titulo" class="secao-titulo">Empresas que fazem a diferença</h2>
      </div>

      <div class="empresas__grade" role="list">
        <% for (const empresa of empresasDestaque) { %>
        <article class="empresa-cartao" role="listitem" aria-label="<%= empresa.nomeFantasia %>">
          <div class="empresa-cartao__topo">
            <div class="empresa-cartao__logo">
              <% if (empresa.logoUrl) { %>
              <img
                src="<%= empresa.logoUrl %>"
                alt="Logo da empresa <%= empresa.nomeFantasia %>"
                class="empresa-cartao__logo-img"
                width="48"
                height="58"
                loading="lazy"
                decoding="async"
              />
              <% } else { %>
                <span class="empresa-cartao__inicial" aria-hidden="true"><%= empresa.nomeFantasia.slice(0, 1).toLocaleUpperCase('pt-BR') %></span>
              <% } %>
            </div>
            <div class="empresa-cartao__selo">
              <svg
                aria-hidden="true"
                focusable="false"
                width="14"
                height="14"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"
                ></path>
              </svg>
              Cadastrada
            </div>
          </div>
          <div class="empresa-cartao__corpo">
            <h3 class="empresa-cartao__nome"><%= empresa.nomeFantasia %></h3>
            <span class="empresa-cartao__categoria"><%= empresa.categoriaEmpresa %></span>
            <p class="empresa-cartao__descricao">
              Conheça os produtos e soluções desta empresa na Empr-E.
            </p>
          </div>
          <div class="empresa-cartao__rodape">
            <a href="/catalogo?empresa=<%= encodeURIComponent(empresa.nomeFantasia) %>" class="btn botao--discreto botao--sm"
              >Ver produtos →</a
            >
          </div>
        </article>
        <% } %>

        <article
          class="empresa-cartao empresa-cartao--acao"
          role="listitem"
          aria-label="Cadastre sua empresa na Empr-E"
        >
          <div class="empresa-cartao__acao-interno">
            <div class="empresa-cartao__acao-icone" aria-hidden="true">+</div>
            <h3 class="empresa-cartao__acao-titulo">Sua empresa aqui</h3>
            <p class="empresa-cartao__acao-texto">
              Cadastre sua empresa e anuncie seus produtos.
            </p>
            <a href="/cadastro" class="btn botao--principal botao--sm">Criar conta</a>
          </div>
        </article>
      </div>

      <div class="empresas__rodape">
        <a href="/empresas" class="btn botao--contorno" aria-label="Empresas"
          >Ver todas as empresas →</a
        >
      </div>
    </div>
  </section>

  <section id="como-funciona" class="como-funciona" aria-labelledby="como-titulo">
    <div class="container">
      <div class="secao-cabecalho">
        <div class="secao-selo">Simples e eficiente</div>
        <h2 id="como-titulo" class="secao-titulo">Como funciona a Empr-E</h2>
      </div>

      <ol class="passos__lista" aria-label="Como comprar e vender na Empr-E">
        <li class="passo">
          <div class="passo__numero" aria-hidden="true">01</div>
          <div class="passo__icone" aria-hidden="true">
            <svg
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M22 21v-2a4 4 0 0 0-1.5-3.07"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
          </div>
          <h3 class="passo__titulo">Pessoas e empresas se cadastram</h3>
          <p class="passo__texto">
            Crie sua conta para comprar ou cadastre sua empresa para oferecer soluções acessíveis.
          </p>
        </li>

        <li class="passo__conector" aria-hidden="true" role="presentation">→</li>

        <li class="passo">
          <div class="passo__numero" aria-hidden="true">02</div>
          <div class="passo__icone" aria-hidden="true">
            <svg
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
              ></path>
            </svg>
          </div>
          <h3 class="passo__titulo">Publicam seus produtos</h3>
          <p class="passo__texto">
            Empresas apresentam seus produtos com fotos, preços e informações para ajudar na escolha.
          </p>
        </li>

        <li class="passo__conector" aria-hidden="true" role="presentation">→</li>

        <li class="passo">
          <div class="passo__numero" aria-hidden="true">03</div>
          <div class="passo__icone" aria-hidden="true">
            <svg
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
          </div>
          <h3 class="passo__titulo">Encontram soluções</h3>
          <p class="passo__texto">
            Explore as categorias e compare opções que atendam às suas necessidades ou às da sua empresa.
          </p>
        </li>

        <li class="passo__conector" aria-hidden="true" role="presentation">→</li>

        <li class="passo">
          <div class="passo__numero" aria-hidden="true">04</div>
          <div class="passo__icone" aria-hidden="true">
            <svg
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M20 12V22H4V12"></path>
              <path d="M22 7H2v5h20V7z"></path>
              <path d="M12 22V7"></path>
              <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
              <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
            </svg>
          </div>
          <h3 class="passo__titulo">Compra e orçamento</h3>
          <p class="passo__texto">
            Escolha seus produtos e avance para a compra ou solicite um orçamento conforme a oferta.
          </p>
        </li>
      </ol>

      <div class="como-funciona__acao">
        <a href="/cadastro" class="btn botao--principal botao--lg">Criar conta</a>
      </div>
    </div>
  </section>

  <section class="diferenciais" aria-labelledby="diferenciais-titulo">
    <div class="container">
      <div class="secao-cabecalho secao-cabecalho--claro">
        <div class="secao-selo secao-selo--claro">Por que a Empr-E</div>
        <h2 id="diferenciais-titulo" class="secao-titulo secao-titulo--claro">
          Feita por quem entende de acessibilidade
        </h2>
      </div>

      <div class="diferenciais__grade" role="list">
        <div class="diferencial" role="listitem">
          <div class="diferencial__icone" aria-hidden="true">
            <svg
