              <path class="ilustracao-inclusao__superficie" d="M282 211h35q8 0 11 10l10 43h-16l-15-33h-29z"></path>
              <path class="ilustracao-inclusao__roupa" d="M280 172q13-9 26 1l8 43h-40z"></path>
