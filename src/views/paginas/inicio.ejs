<main id="conteudo-principal" tabindex="-1" role="main">
  <section class="destaque" aria-labelledby="destaque-titulo">
    <div class="container destaque__interno">
      <div class="destaque__conteudo">
        <div class="destaque__selo" aria-hidden="true">
          <span class="destaque__selo-ponto"></span>
          Acessibilidade para pessoas e empresas
        </div>

        <h1 id="destaque-titulo" class="destaque__titulo">
          Conectando pessoas e empresas que <em class="destaque__titulo-destaque"
            >acreditam na inclusão.</em
          >
        </h1>

        <p class="destaque__subtitulo">
          Acessibilidade para todos os tipos de deficiência, visíveis ou não. Conectamos pessoas
          e empresas a soluções para ampliar a autonomia e a inclusão no dia a dia.
        </p>

        <div class="destaque__acoes d-flex flex-wrap align-items-center gap-3">
          <a href="/catalogo" class="btn botao--principal botao--lg" aria-label="Catálogo">
            <svg
              aria-hidden="true"
              focusable="false"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
            Explorar o catálogo
          </a>
          <a href="#empresas" class="btn botao--contorno botao--lg" aria-label="Empresas">
            Conhecer as empresas
            <svg
              aria-hidden="true"
              focusable="false"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>
        </div>
      </div>
