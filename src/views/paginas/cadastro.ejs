<main id="conteudo-principal" class="cadastro-principal" tabindex="-1">
  <div class="container cadastro-conteiner">
    <div class="cadastro-cabecalho">
      <span class="secao-selo">Pessoas e empresas</span>
      <h1 class="cadastro-titulo">Criar conta</h1>
      <p class="demo-nota" id="cadastro-aviso">
        Crie sua conta para comprar produtos de acessibilidade.
        Empresas cadastradas como vendedoras poderão anunciar após concluir o cadastro.
      </p>
    </div>
    <form
      class="cadastro-formulario"
      action="/cadastro"
      method="POST"
      enctype="multipart/form-data"
      aria-describedby="cadastro-aviso"
    >
    <% if (erro) { %>
  <div class="cadastro-erro" role="alert" aria-live="assertive">
    <strong>Não foi possível criar sua conta.</strong>
    <p><%= erro %></p>
  </div>
<% } %>
      <fieldset class="formulario-secao">
        <legend class="formulario-secao__titulo">Tipo de conta</legend>
        <div class="campos-linha">
          <div class="campo-grupo">
            <label for="pessoa-tipo" class="campo-rotulo">Tipo de pessoa</label
            >
            <select
  id="pessoa-tipo"
  name="tipoPessoa"
  class="campo-entrada campo-seletor"
  required
>
  <option value="pf" <%= (dados?.tipoPessoa || 'pf') === 'pf' ? 'selected' : '' %>>
    Pessoa física
  </option>
  <option value="pj" <%= dados?.tipoPessoa === 'pj' ? 'selected' : '' %>>
    Pessoa jurídica
  </option>
</select>
          </div>
          <div class="campo-grupo">
            <label for="perfil-comercial" class="campo-rotulo">Objetivo na plataforma</label
            >
            <select
  id="perfil-comercial"
  name="perfilComercial"
  class="campo-entrada campo-seletor"
  required
>
  <option value="comprador" <%= (dados?.perfilComercial || 'comprador') === 'comprador' ? 'selected' : '' %>>
    Comprar
  </option>
  <option value="vendedor" <%= dados?.perfilComercial === 'vendedor' ? 'selected' : '' %>>
    Vender — somente pessoa jurídica
  </option>
</select>
          </div>
        </div>
        <p class="campo-dica">
          Pessoa física e jurídica podem comprar. Apenas pessoa jurídica poderá vender.
        </p>
      </fieldset>
      <fieldset class="formulario-secao" hidden="" data-campos-pj="">
        <legend class="formulario-secao__titulo">Dados da empresa</legend>
        <div class="campos-linha">
          <div class="campo-grupo">
            <label for="razao-social" class="campo-rotulo">Razão social</label
            >
            <input
  id="razao-social"
  name="razaoSocial"
  class="campo-entrada"
  placeholder="Razão social"
  autocomplete="organization"
  value="<%= dados?.razaoSocial || '' %>"
  required
/>
            <label for="nome-fantasia" class="campo-rotulo">Nome Fantasia</label
            >
            <input
  id="nome-fantasia"
  name="nomeFantasia"
  class="campo-entrada"
  placeholder="Nome fantasia"
  autocomplete="organization"
  value="<%= dados?.nomeFantasia || '' %>"
  required
/>

          </div>
          <div class="campo-grupo">
            <label for="cnpj" class="campo-rotulo">CNPJ</label
            >
            <input
    id="cnpj"
    name="cnpj"
    class="campo-entrada"
    placeholder="00.000.000/0000-00"
    inputmode="numeric"
    autocomplete="off"
    maxlength="18"
    value="<%= dados?.cnpj || '' %>"
    required
/>
          </div>
        </div>
        <div class="campo-grupo">
          <label for="logo-empresa" class="campo-rotulo">Logo da empresa (opcional)</label>
          <input
            id="logo-empresa"
            name="logoEmpresa"
            class="campo-entrada"
            type="file"
            accept="image/jpeg,image/png,image/webp"
            aria-describedby="logo-empresa-dica"
          />
          <p class="campo-dica" id="logo-empresa-dica">
            JPEG, PNG ou WebP · Até 5 MB. A logo será exibida na página de empresas.
          </p>
        </div>
      </fieldset>
      <fieldset class="formulario-secao">
        <legend class="formulario-secao__titulo">Dados pessoais / responsável</legend>
        <div class="campo-grupo">
          <label for="nome" class="campo-rotulo">Nome completo</label>
          <input
  id="nome"
  name="nomeCompleto"
  class="campo-entrada"
  placeholder="Nome completo"
  autocomplete="name"
  value="<%= dados?.nomeCompleto || '' %>"
  required
/>
        </div>

        <div class="campo-grupo">
          <label for="cpf-pessoa" class="campo-rotulo">CPF</label>
          <input
    id="cpf-pessoa"
    name="cpfPessoa"
    class="campo-entrada"
    placeholder="000.000.000-00"
    inputmode="numeric"
    autocomplete="off"
    maxlength="14"
    value="<%= dados?.cpfPessoa || '' %>"
    required
/>
        </div>

        <div class="campo-grupo">
          <label for="email" class="campo-rotulo">E-mail de acesso</label>
         <input
  id="email"
  name="email"
  type="email"
  class="campo-entrada"
  placeholder="nome@exemplo.com"
  autocomplete="email"
  value="<%= dados?.email || '' %>"
  required
/>
        </div>

        <div class="campo-grupo">
          <label for="telefone" class="campo-rotulo">Telefone</label>
          <input
  id="telefone"
  name="telefone"
  type="tel"
  class="campo-entrada"
  placeholder="(00) 00000-0000"
  autocomplete="tel"
  value="<%= dados?.telefone || '' %>"
/>
        </div>
      </fieldset>
      <fieldset class="formulario-secao">
        <legend class="formulario-secao__titulo">Dados de acesso</legend>
        <div class="campos-linha">
    <div class="campo-grupo">
        <label for="senha" class="campo-rotulo">Senha</label>

        <div class="senha-container">
            <input
                id="senha"
                name="senha"
                class="campo-entrada"
                type="password"
                autocomplete="new-password"
                minlength="8"
                required
            />

            <button
                type="button"
                class="senha-alternar"
                data-toggle-senha="senha"
                aria-label="Mostrar senha"
                aria-pressed="false"
            >
                Mostrar
            </button>
        </div>
    </div>

    <div class="campo-grupo">
        <label for="confirmar-senha" class="campo-rotulo">
            Confirmar senha
        </label>

        <div class="senha-container">
            <input
                id="confirmar-senha"
                name="confirmarSenha"
                class="campo-entrada"
                type="password"
                autocomplete="new-password"
                minlength="8"
                required
            />

            <button
                type="button"
                class="senha-alternar"
                data-toggle-senha="confirmar-senha"
                aria-label="Mostrar senha"
                aria-pressed="false"
            >
                Mostrar
            </button>
        </div>
    </div>
</div>
      </fieldset>
      <button type="submit" class="btn botao--principal botao--lg">
        Criar conta
      </button>
      <a href="/login" class="btn botao--discreto">Já tenho conta</a>
    </form>
  </div>
</main>
<script src="/assets/js/cadastro.js" defer></script>
