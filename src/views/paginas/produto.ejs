
<main id="conteudo-principal" tabindex="-1">
  <section class="produto-detalhe-destaque">
    <div class="container">
      <div class="produto-detalhe-destaque__conteudo">
        <h1 class="produto-detalhe-destaque__titulo">
          Detalhes do produto
        </h1>
                <p>
          <% if (produto.variantes.length > 1) { %>
            Escolha a variação e informe a quantidade desejada.
          <% } else { %>
            Informe a quantidade desejada e adicione o produto ao carrinho.
          <% } %>
        </p>
      </div>
    </div>
  </section>

  <section class="produto-detalhe-secao">
    <div class="container">
      <div class="produto-detalhe" id="produto-detalhe">
        <div class="produto-detalhe__galeria">
          <div class="produto-detalhe__imagem-principal-wrap">
            <img
              id="produto-detalhe-imagem-principal"
              src="<%= produto.variantes[0].imagem %>"
              alt="<%= produto.nome %> — <%= produto.variantes[0].variacao %>"
              class="produto-detalhe__imagem-principal"
              width="600"
              height="480"
            />
          </div>

          <% if (produto.variantes.length > 1) { %>
            <div class="produto-detalhe__miniaturas">
              <% produto.variantes.forEach((variante, indice) => { %>
                <button
                  type="button"
                  class="produto-detalhe__miniatura<%= indice === 0 ? ' produto-detalhe__miniatura--ativo' : '' %>"
                  aria-label="Selecionar variação <%= variante.variacao %>"
                  aria-pressed="<%= indice === 0 ? 'true' : 'false' %>"
                  data-imagem-miniatura="<%= variante.imagem %>"
                  data-variacao="<%= variante.variacao %>"
                >
                  <img src="<%= variante.imagem %>" alt="" width="60" height="60" />
                  <span><%= variante.variacao %></span>
                </button>
              <% }); %>
            </div>
          </div>
        <% } %>

        <div class="produto-detalhe__informacoes">
          <a href="/catalogo" class="btn botao--discreto botao--sm">
            Voltar ao catálogo
          </a>

          <span class="produto-detalhe__categoria">
            <%= produto.categoria.nome %>
          </span>

          <h2 class="produto-detalhe__titulo">
            <%= produto.nome %>
          </h2>

          <p class="produto-detalhe__empresa">
            Fornecedor: <%= produto.empresa.nome %>
          </p>

          <p class="produto-detalhe__descricao">
            <%= produto.descricao %>
          </p>

          <div class="produto-detalhe__resumo">
            <div class="produto-detalhe__painel">
              <span class="produto-detalhe__painel-rotulo">Preço</span>
              <div class="produto-detalhe__preco">
                <%= formatarMoeda(produto.preco) %>/<%= produto.unidade %>
              </div>
            </div>

            <div class="produto-detalhe__painel">
              <span class="produto-detalhe__painel-rotulo">Modalidade</span>
              <div class="produto-detalhe__modalidade">
                <%= produto.nomeModalidade %>
              </div>
            </div>
          </div>

          <% if (produto.variantes.length > 1) { %>
            <p id="variacao-estado" role="status" aria-live="polite">
              Tipo selecionado: <%= produto.variantes[0].variacao %>
            </p>
          <% } %>

          <div class="produto-detalhe__acoes">
            <form action="/carrinho/itens" method="post">
              <input
                type="hidden"
                name="produtoId"
                value="<%= produto.id %>"
              />

              <div class="produto-detalhe__campo-quantidade">
                <label for="quantidade-produto">Quantidade</label>
                <input
                  type="number"
                  id="quantidade-produto"
                  name="quantidade"
                  value="1"
                  min="1"
                  max="999"
                  step="1"
                  required
                />
              </div>

              <input
                type="hidden"
                name="variacao"
                id="variacao-selecionada"
                value="<%= produto.variantes[0].variacao %>"
              />

              <button type="submit" class="btn botao--principal">
                Adicionar ao carrinho
              </button>
            </form>

            <a href="/carrinho" class="btn botao--contorno">
              Ver carrinho
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>
